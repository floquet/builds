[user]
	name = Daniel Topa
	email = dantopa@gmail.com
[init]
	defaultBranch = main
[pull]
	rebase = false
[push]
	default = simple
	autoSetupRemote = true
[color]
	ui = auto
[core]
	editor = vim
	pager = less -FRX
[merge]
	tool = meld
[rerere]
	enabled = true
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
